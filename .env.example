# Copy to .env and fill in. Shell environment variables take precedence.

# --- 9router (OpenAI-compatible gateway; also speaks Anthropic Messages) ---
# Model ids are 9router/<id>: a combo (All, Safe, Coding, General, Fast, Reasoning,
# Vision, local) or any individual id the gateway serves.
HARNESS2_9ROUTER_BASE_URL=http://127.0.0.1:20128/v1
HARNESS2_9ROUTER_API_KEY=
# Gateway dashboard password. Only the harness control plane's key and settings
# calls use it; a model call never does.
HARNESS2_9ROUTER_ADMIN_PASSWORD=

# --- Models ---
# Executor (solver) and improver, in OpenCode's provider/model syntax.
HARNESS2_SOLVER_MODEL=9router/All
HARNESS2_IMPROVER_MODEL=9router/All

# Judge model. The LAB judge reaches 9router over Anthropic Messages; the
# JobBench judge over OpenAI chat completions.
HARNESS2_JUDGE_MODEL=9router/claude-sonnet-4-6

# --- Vertex AI (alternative backend) ---
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global

# --- Output ---
HARNESS2_RUNS_DIR=runs/

# --- Telegram bot (optional; `harness2-telegram`) ---
# The bot is a front end for the running task panel, so harness2-web must be up.
# It polls Telegram, which means no public URL or webhook is needed.
TELEGRAM_BOT_ID=
TELEGRAM_BOT_TOKEN=
# The one chat the bot answers. Leave it empty to have the bot reply to
# `/whoami` and nothing else, which is how this value is obtained: a bot is
# reachable by whoever learns its username, and every task it starts runs an
# agent with write access to a project directory.
HARNESS2_TELEGRAM_CHAT_ID=

# --- Proxies (optional) ---
# Telegram is not reachable from this host directly, so the bot tunnels every
# call. `host:port`, SOCKS5, no auth. Numbered names are an ordered list: the
# bot uses the first that carries a request and remembers it. The name orders
# by number, so SOCKS5_10 follows SOCKS5_09 rather than SOCKS5_01.
SOCKS5_01=
SOCKS5_02=
